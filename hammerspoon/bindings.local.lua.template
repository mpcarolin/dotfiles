--- Per-machine shortcuts. Copy to `bindings.local.lua` (gitignored) and edit.
---
--- Merged AFTER bindings.lua; a row here reusing a hotkey from there is
--- reported as a duplicate, so change the key rather than shadowing it.

return {
  -- Theme switching — `theme` lives in this machine's dotfiles/bin.
  -- Toggle between favourites (themes/favorites.local), not all 13.
  { { 'cmd', 'shift' }, 'T', cmd = 'theme toggle' },
  { { 'cmd', 'shift' }, 'W', cmd = 'theme wallpaper next' },

  -- Popup theme picker: type to filter, arrows to move, enter to apply.
  {
    { 'cmd', 'shift' },
    'P',
    choose = require('lib.theme').picker(),
    requires = 'theme',
  },
}
